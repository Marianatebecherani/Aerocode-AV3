// --- INÍCIO DA CONFIGURAÇÃO ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- USUÁRIOS ---
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  name     String
  role     String 
}

// --- PROJETOS ---
model Project {
  id         String   @id 
  title      String
  status     String
  idNumber   String
  value      String
  progress   Int
  statusType String
  createdAt  DateTime @default(now())

  steps ProjectStep[]
}

// --- ETAPAS ---
model ProjectStep {
  id        Int         @id @default(autoincrement())
  title     String
  status    String
  tasks     String      @db.Text 
  
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  
  components Component[]

  @@index([projectId])
}

// --- COMPONENTES (ASAS, MOTORES, ETC) ---
model Component {
  id          Int         @id @default(autoincrement())
  title       String
  status      String
  statusType  String      // 'success', 'error', 'warning'
  lastUpdate  DateTime    @default(now())
  
  // QC Info
  qcStatus    String?     
  qcDate      String?
  qcInspector String?
  qcNotes     String?     @db.Text
  
  stepId      Int
  step        ProjectStep @relation(fields: [stepId], references: [id])
  
  // RELAÇÕES NOVAS
  requiredParts RequiredPart[]
  activityLogs  ActivityLog[]
  
  @@index([stepId])
}

// --- NOVAS TABELAS ---

// Peças necessárias para este componente
model RequiredPart {
  id           Int       @id @default(autoincrement())
  name         String
  status       String    // 'REPROVADA', 'Aprovada', 'Pendente'
  action       String?   // 'Novo pedido solicitado...'
  actionStatus String?   // 'Aguardando Entrega'
  statusType   String    // 'error', 'success', 'warning'
  
  componentId  Int
  component    Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  
  @@index([componentId])
}

// Log de atividades do componente
model ActivityLog {
  id           Int       @id @default(autoincrement())
  text         String
  statusType   String    // 'info', 'error', 'success'
  timestamp    DateTime  @default(now())
  
  componentId  Int
  component    Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

// --- OUTROS ---
model InventoryItem {
  id         String @id 
  name       String
  quantity   Int
  status     String
  statusType String
}

model QcItem {
  id           Int    @id @default(autoincrement())
  componenteId String
  inspetor     String
  data         String
  status       String
  notas        String @db.Text
}